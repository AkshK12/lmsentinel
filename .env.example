# Template only. `python -m lms_scraper setup` creates your own .env from this.
# NEVER put a real password in this file: it is committed to GitHub.

LMS_USERID=
# Leave empty: setup stores your password in the OS keychain. Only used if no keychain exists.
LMS_PASSWORD=

# Your own Telegram bot (fill via: python -m lms_scraper telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Leave empty to use the bundled Chromium; "chrome" uses an installed Google Chrome
BROWSER_CHANNEL=

LMS_BASE_URL=https://campus.thapar.edu
LMS_SITE=csprd
HEADLESS=true
POLL_INTERVAL_SECONDS=900
POLL_JITTER_SECONDS=120
NAV_TIMEOUT_MS=45000

# --- navigation tuning (regex, case-insensitive) ---
# NAV_GRADES_REGEX=view\s*my\s*grades
# NAV_ASSIGNMENTS_REGEX=view\s*my\s*assignments
# NAV_CONTINUE_REGEX=^\s*continue\s*$
# NAV_CHANGE_CLASS_REGEX=change\s*class
# TERM_STRATEGY=last           # last (= latest on Thapar) | first | regex matched against the term row
# SUBJECT_LINK_REGEX=          # e.g. ^U[A-Z]{2}\d{3}
# ASSIGNMENTS_URL=             # direct component URL (skips 2 clicks)
